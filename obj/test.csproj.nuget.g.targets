    <Import Project="$(NuGetPackageRoot)microsoft.playwright\1.62.0\buildTransitive\Microsoft.Playwright.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.playwright\1.62.0\buildTransitive\Microsoft.Playwright.targets')" />
    <Import Project="$(NuGetPackageRoot)microsoft.extensions.configuration.binder\10.0.12\buildTransitive\netstandard2.0\Microsoft.Extensions.Configuration.Binder.targets" Condition="Exists('$(NuGetPackageRoot)microsoft.extensions.configuration.binder\10.0.12\buildTransitive\netstandard2.0\Microsoft.Extensions.Configuration.Binder.targets')" />
